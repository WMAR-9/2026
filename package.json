{
  "name": "2026-unicorn",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -fr ./dist && npm run build:vite && npm run build:roadroller && npm run build:zip",
    "build:vite": "vite build",
    "build:roadroller": "roadroller dist/main.js -o dist/main.min.js",
    "build:zip": "node build.js",
    "preview": "vite preview",
    "deploy": "npm run vup && git add . && git commit -m \"Deploy v$npm_package_version - $(date +'%Y-%m-%d')\" && git push",
    "page": "git add -f tools && git commit -m \"New build\" && git push && git subtree push --prefix=tools origin gh-pages",
    "vup": "npm version patch",
    "vun": "npm version minor",
    "vum": "npm version major"
  },
  "devDependencies": {
    "advzip-bin": "^1.1.0",
    "chalk": "^5.3.0",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.1.1",
    "jszip": "^3.10.1",
    "roadroller": "^2.1.0",
    "terser": "^5.31.1",
    "vite": "^5.3.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-image-optimizer": "^2.0.0",
    "vite-plugin-imagemin": "^0.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  }
}
